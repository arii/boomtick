{
  "name": "@arii/boomtick-mcp",
  "version": "0.12.0",
  "description": "Boomtick MCP Guide: PR Rescue + Merge Conflict Agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/arii/boomtick.git",
    "directory": "mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "boomtick-mcp": "dist/index.js",
    "boomtick-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "pnpm --filter @arii/boomtick-workflows build && tsx scripts/sync-contracts.ts && tsc && tsx scripts/sync-mcp-schemas.ts && node scripts/vendor-workflows-dist.mjs",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "test": "pnpm --filter @arii/boomtick-workflows build && tsx scripts/sync-contracts.ts && tsx scripts/sync-mcp-schemas.ts && vitest run",
    "run-evals": "node dist/evals/run-evals.js",
    "sync:mcp-schemas": "tsx scripts/sync-mcp-schemas.ts",
    "release:patch": "pnpm version patch",
    "release:minor": "pnpm version minor",
    "release:major": "pnpm version major",
    "sync-contracts": "tsx scripts/sync-contracts.ts",
    "type-check": "pnpm --filter @arii/boomtick-workflows build && tsx scripts/sync-contracts.ts && tsc",
    "lint": "pnpm --filter @arii/boomtick-workflows build && tsx scripts/sync-contracts.ts && tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.2"
  },
  "devDependencies": {
    "@arii/boomtick-workflows": "workspace:*",
    "@types/node": "^20.17.15",
    "json-schema-to-zod": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
