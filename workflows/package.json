    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@types/node": "^20.17.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
