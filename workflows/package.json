{
  "name": "@arii/boomtick-workflows",
  "version": "0.1.0",
  "description": "Constrained LangGraph.js workflows for boomtick: deterministic graphs over small models, exposed through the run_workflow MCP gateway.",
  "repository": {
    "type": "git",
