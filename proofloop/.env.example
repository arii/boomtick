TYPESAFE_MODEL=typesafe/jev-1.14.0
# Cognee Cloud: https://tenant-<id>.aws.cognee.ai plus key and tenant id. Self-hosted: http://localhost:8000
COGNEE_API_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=
OPENROUTER_API_KEY=
