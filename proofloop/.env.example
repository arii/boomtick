# Historical .env files are NOT loaded. Do not paste secrets here.
# Non-secret process flags only. Configure through an approved secret manager.
# Credential presence never activates a service.
PROOFLOOP_FORCE_STUB=1
# After specific input, destination and credit-use approval only:
# PROOFLOOP_LIVE_SERVICES=cognee,senso,llm
# PROOFLOOP_ALLOW_SESSION_UPLOAD=1
# PROOFLOOP_INCLUDE_LOCAL_SKILLS=1
# PROOFLOOP_EXTENSION_ID=<exact-32-letter-extension-id>
# Mutation LLM through the local Tokens with Taste gateway (no ProofLoop key; gateway holds provider keys):
# PROOFLOOP_LIVE_SERVICES=twt
# TWT_BASE_URL=http://127.0.0.1:8000/v1   # loopback only
# Chrome extension ID for the read-only backend origin check (not a secret):
# PROOFLOOP_EXTENSION_ID=cbpokmfdbbcpgaookmhdgnbdcgkjkodl
