{
  "manifest_version": 3,
  "name": "ProofLoop",
  "version": "0.2.0",
  "description": "Quiet inline assistant: warns before a form field contradicts a rule from your own sessions. No chat.",
  "permissions": [
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://luma.com/*",
        "https://lu.ma/*",
        "https://*.luma.com/*",
        "https://workatastartup.com/*",
        "https://www.workatastartup.com/*"
      ],
      "js": [
        "assist/detect.js",
        "assist/match.js",
        "assist/assist.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
