{
  "manifest_version": 3,
  "name": "ProofLoop",
  "version": "0.1.0",
  "description": "Quiet inline chips backed by replay-verified skills. No chat.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "options_page": "options.html"
}
