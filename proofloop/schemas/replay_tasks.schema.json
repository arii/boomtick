{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayTaskSuite",
  "description": "Replay tasks generated from sessions by tasks.py (LLM), then reviewed. Checks are evaluated on real LLM answers.",
  "type": "object",
  "required": [
    "suite_id",
    "generated",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "suite_id": {
      "type": "string"
    },
    "generated": {
      "type": "object",
      "required": [
        "by",
        "at",
        "reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "sessions_sha256": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_session_id",
          "task_kind",
          "query",
          "active_tab",
          "related_tabs",
          "checks",
          "split"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^t_[a-z0-9_]+$"
          },
          "source_session_id": {
            "type": "string"
          },
          "task_kind": {
            "enum": [
              "job_application",
              "event_registration",
              "insurance_or_service_quote",
              "account_signup",
              "profile_edit",
              "scheduling",
              "publishing_claims",
              "verification",
              "other"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 8,
            "maxLength": 400
          },
          "active_tab": {
            "$ref": "#/$defs/tab"
          },
          "related_tabs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/$defs/tab"
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "#/$defs/check"
            }
          },
          "split": {
            "enum": [
              "train",
              "holdout"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "required": [
        "title",
        "url",
        "snippet"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "must_include",
            "must_not_include",
            "asks_clarification",
            "no_unsupported_claims"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
